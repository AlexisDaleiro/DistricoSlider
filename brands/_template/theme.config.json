{
  "schemaVersion": 1,
  "brand": {
    "id": "_template",
    "name": "Tu marca",
    "appName": "Tu marca Puzzle",
    "androidAppId": "uy.kioskpuzzle.template",
    "logo": "assets/logo.svg",
    "logoOnPrimary": "assets/logo-mono.svg"
  },
  "event": {
    "id": "demo-2026",
    "name": "Experiencias que conectan",
    "locale": "es-UY"
  },
  "theme": {
    "colors": {
      "primary": "#70d9e8",
      "onPrimary": "#172016",
      "secondary": "#FF8C67",
      "onSecondary": "#231A14",
      "background": "#111B24",
      "surface": "#1B2935",
      "text": "#F5F7F3",
      "textMuted": "#A6B5C0",
      "success": "#79DCA7",
      "danger": "#FF8993",
      "tileGap": "#111B24"
    },
    "fonts": {
      "heading": {
        "family": "Space Grotesk",
        "file": "assets/fonts/space-grotesk-latin-700-normal.woff2",
        "weight": 700
      },
      "body": {
        "family": "DM Sans",
        "file": "assets/fonts/dm-sans-latin-400-normal.woff2",
        "weight": 400
      }
    },
    "radius": "20px",
    "backgroundImage": null
  },
  "attract": {
    "mode": "slideshow",
    "media": ["assets/attract/cover.webp"],
    "slideIntervalMs": 6000,
    "headline": "Cada pieza cuenta.",
    "cta": "Tocá para jugar"
  },
  "form": {
    "title": "Dejanos tus datos para participar",
    "fields": [
      {
        "id": "name",
        "type": "text",
        "label": "Nombre y apellido",
        "required": true,
        "minLength": 3,
        "maxLength": 80
      },
      {
        "id": "email",
        "type": "email",
        "label": "Email",
        "required": true
      },
      {
        "id": "company",
        "type": "text",
        "label": "Empresa",
        "required": false,
        "maxLength": 80
      },
      {
        "id": "phone",
        "type": "tel",
        "label": "Teléfono",
        "required": false,
        "defaultCountry": "UY"
      }
    ],
    "consent": {
      "required": true,
      "version": "2026-10-01",
      "text": "Acepto el tratamiento de mis datos para participar. Texto de demostración: reemplazar antes de un evento."
    },
    "marketingOptIn": {
      "enabled": true,
      "text": "Quiero recibir novedades y promociones."
    },
    "submit": "¡Jugar!"
  },
  "game": {
    "gridSize": 3,
    "images": [
      {
        "src": "assets/puzzle/hero.webp",
        "focalPoint": {
          "x": 0.5,
          "y": 0.5
        }
      }
    ],
    "imageSelection": "random",
    "shuffleMoves": {
      "3": 60,
      "4": 160
    },
    "showTileNumbers": false,
    "showPreviewButton": true,
    "countdownSec": 3,
    "maxDurationSec": 300,
    "tileAnimationMs": 130,
    "invalidMoveAnimationMs": 120,
    "victoryAnimationMs": 400,
    "swipeThresholdPx": 24
  },
  "leaderboard": {
    "size": 10,
    "nameFormat": "firstNameLastInitial",
    "showCompany": true,
    "repeatPlayers": "bestScoreOnly"
  },
  "kiosk": {
    "orientation": "landscape",
    "inactivityMs": {
      "form": 60000,
      "countdown": 30000,
      "game": 90000,
      "result": 15000,
      "leaderboard": 20000,
      "admin": 60000
    },
    "warningMs": 10000,
    "adminHotspot": "top-right",
    "adminTapCount": 5,
    "adminTapWindowMs": 3000
  },
  "export": {
    "filePrefix": "leads__template",
    "csvSeparator": ";",
    "includeXlsx": true
  },
  "texts": {
    "showcase.eyebrow": "Una marca. Todas sus piezas.",
    "showcase.description": "Formas, colores y un desafío por descubrir. Una experiencia pensada para conectar con tu marca.",
    "showcase.status": "Identidad lista · Motor verificado",
    "showcase.imageAlt": "Composición de nueve zonas de colores con círculo, triángulo, cruz, rombo, cuadrado, arco, barras, anillo y estrella.",
    "showcase.imageCaption": "La imagen que da forma al desafío",
    "showcase.grid": "{size} × {size}",
    "showcase.scope": "Vista de marca · Fases 1 y 2"
  }
}
