{
  "schemaVersion": 1,
  "brand": {
    "id": "districo",
    "name": "DISTRICO",
    "appName": "Districo Puzzle",
    "androidAppId": "uy.kioskpuzzle.districo",
    "logo": "assets/logo.jpg",
    "logoOnPrimary": "assets/logo.jpg"
  },
  "event": {
    "id": "districo-demo",
    "name": "Cada conexión cuenta.",
    "locale": "es-UY"
  },
  "theme": {
    "colors": {
      "primary": "#204F5F",
      "onPrimary": "#FFFFFF",
      "secondary": "#B1CA00",
      "onSecondary": "#204F5F",
      "background": "#F3F8F8",
      "surface": "#FFFFFF",
      "text": "#204F5F",
      "textMuted": "#526B73",
      "success": "#22704D",
      "danger": "#AE3548",
      "tileGap": "#DDE7E8"
    },
    "fonts": {
      "heading": {
        "family": "Space Grotesk",
        "file": "assets/fonts/space-grotesk-latin-700-normal.woff2",
        "weight": 700
      },
      "body": {
        "family": "DM Sans",
        "file": "assets/fonts/dm-sans-latin-400-normal.woff2",
        "weight": 400
      }
    },
    "radius": "18px",
    "backgroundImage": null
  },
  "attract": {
    "mode": "slideshow",
    "media": ["assets/attract/cover.webp"],
    "slideIntervalMs": 6000,
    "headline": "Conectá todas las piezas.",
    "cta": "Empezar el desafío"
  },
  "form": {
    "title": "Dejanos tus datos para participar",
    "fields": [
      {
        "id": "name",
        "type": "text",
        "label": "Nombre y apellido",
        "required": true,
        "minLength": 3,
        "maxLength": 80
      },
      {
        "id": "email",
        "type": "email",
        "label": "Email",
        "required": true
      },
      {
        "id": "company",
        "type": "text",
        "label": "Empresa",
        "required": false,
        "maxLength": 80
      },
      {
        "id": "phone",
        "type": "tel",
        "label": "Teléfono",
        "required": false,
        "defaultCountry": "UY"
      }
    ],
    "consent": {
      "required": true,
      "version": "2026-10-01",
      "text": "Acepto el tratamiento de mis datos para participar. Texto de demostración: reemplazar antes de un evento."
    },
    "marketingOptIn": {
      "enabled": true,
      "text": "Quiero recibir novedades y promociones."
    },
    "submit": "¡Jugar!"
  },
  "game": {
    "gridSize": 3,
    "images": [
      {
        "src": "assets/puzzle/biofresh.jpg",
        "focalPoint": {
          "x": 0.5,
          "y": 0.5
        }
      },
      {
        "src": "assets/puzzle/granplus-carne.jpg",
        "focalPoint": {
          "x": 0.5,
          "y": 0.5
        }
      },
      {
        "src": "assets/puzzle/granplus-salmon.jpg",
        "focalPoint": {
          "x": 0.5,
          "y": 0.5
        }
      }
    ],
    "imageSelection": "random",
    "shuffleMoves": {
      "3": 60,
      "4": 160
    },
    "showTileNumbers": false,
    "showPreviewButton": true,
    "countdownSec": 3,
    "maxDurationSec": 300,
    "tileAnimationMs": 130,
    "invalidMoveAnimationMs": 120,
    "victoryAnimationMs": 400,
    "swipeThresholdPx": 24,
    "sounds": {
      "enabled": false,
      "move": "assets/sounds/move.wav",
      "win": "assets/sounds/win.wav"
    }
  },
  "leaderboard": {
    "size": 10,
    "nameFormat": "firstNameLastInitial",
    "showCompany": true,
    "repeatPlayers": "bestScoreOnly"
  },
  "kiosk": {
    "orientation": "landscape",
    "inactivityMs": {
      "form": 60000,
      "countdown": 30000,
      "game": 90000,
      "result": 15000,
      "leaderboard": 20000,
      "admin": 60000
    },
    "warningMs": 10000,
    "errorRecoveryMs": 2000,
    "adminHotspot": "top-right",
    "adminTapCount": 5,
    "adminTapWindowMs": 3000,
    "admin": {
      "pinTimeoutMs": 20000,
      "resetHoldMs": 2000,
      "deleteHoldMs": 3000,
      "lockoutBaseMs": 30000,
      "lockoutMaxMs": 900000,
      "maxAttempts": 3,
      "exportFreshMs": 600000
    },
    "splashMs": 1200
  },
  "export": {
    "filePrefix": "leads_districo",
    "csvSeparator": ";",
    "includeXlsx": true
  },
  "texts": {
    "showcase.eyebrow": "Una marca. Todas sus piezas.",
    "showcase.description": "Un desafío para mirar distinto. Deslizá las piezas, encontrá su lugar y armá la imagen completa.",
    "showcase.status": "Identidad lista · Motor verificado",
    "showcase.imageAlt": "Composición de nueve zonas de colores con círculo, triángulo, cruz, rombo, cuadrado, arco, barras, anillo y estrella.",
    "showcase.imageCaption": "Cada pieza tiene su lugar.",
    "showcase.grid": "{size} × {size}",
    "showcase.scope": "Vista de marca · Fases 1 y 2",
    "game.eyebrow": "El desafío Districo"
  }
}
