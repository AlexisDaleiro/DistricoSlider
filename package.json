{
  "name": "kiosk-puzzle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsx scripts/check-web-build.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand:validate": "tsx scripts/validate-brand.ts",
    "assets:generate": "tsx scripts/generate-placeholders.ts",
    "brand:build": "tsx scripts/build-brand.ts",
    "android:patch": "tsx scripts/patch-android.ts",
    "assets:sounds": "tsx scripts/generate-sounds.ts",
    "web:check": "tsx scripts/check-web-build.ts"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "dexie": "4.4.6",
    "libphonenumber-js": "1.13.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@capacitor/assets": {
      "sharp": "$sharp",
      "tar": "7.5.22"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
